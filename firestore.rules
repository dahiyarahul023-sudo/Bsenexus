rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        !('email' in request.auth.token) ||
        request.auth.token.email == null ||
        request.auth.token.email == ''
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && !isAnonymous() && (
        (request.auth.token.email == 'dahiyarahul023@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // Role tampering / privilege escalation guard
    // SECURITY (1 Oct 2026 audit SEC-003): Expanded to block ALL Pro/payment-related
    // fields. Previously only blocked role/isAdmin/admin/isPro — a client could write
    // tier='pro' or proExpiresAt=<future> directly to their own users doc and gain
    // unlimited free Pro (bypassing Cashfree payment entirely). Now blocks:
    // - role, isAdmin, admin, isPro (admin/role escalation)
    // - tier, proExpiresAt, proPlanId (Pro status forgery)
    // - lastPaymentAt, lastOrderId, grantedOrderIds (payment history forgery)
    // - maxWatchlistStocks (limit bypass)
    // - freeSummaryUsed, trialUsed (entitlement bypass)
    // Only the Admin SDK (which bypasses these rules) can write these fields.
    function isNotElevatingRole() {
      return (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
             (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true) &&
             (!('admin' in request.resource.data) || request.resource.data.admin != true) &&
             (!('isPro' in request.resource.data) || request.resource.data.isPro != true) &&
             !('tier' in request.resource.data) &&
             !('proExpiresAt' in request.resource.data) &&
             !('proPlanId' in request.resource.data) &&
             !('lastPaymentAt' in request.resource.data) &&
             !('lastOrderId' in request.resource.data) &&
             !('grantedOrderIds' in request.resource.data) &&
             !('maxWatchlistStocks' in request.resource.data) &&
             !('freeSummaryUsed' in request.resource.data) &&
             !('trialUsed' in request.resource.data);
    }

    // BSE Announcements: Public read for regulatory disclosure, writes restricted to Admin/Server
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Results Calendar: Public read, writes restricted to Admin/Server
    match /results_calendar/{calendarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Settings: Read & Write restricted to Admin/Server (Strictly denied to anonymous)
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // System Logs: Read & Write restricted to Admin/Server (Strictly denied to anonymous)
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // User Watchlists: Strict UID-scoped access.
    // Anonymous guests & authenticated users can only access their OWN UID document.
    match /user_watchlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /user_watchlists/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // User Profiles & Subcollections: Strict UID-scoped ownership enforcement.
    // Anonymous guests & users can manage their own profile and subcollections,
    // but cannot elevate privileges or read/write other users' data.
    // SECURITY (1 Oct 2026 audit SEC-003): update rule now uses isNotElevatingRole()
    // which blocks ALL Pro/payment-related fields (tier, proExpiresAt, proPlanId,
    // lastPaymentAt, lastOrderId, maxWatchlistStocks, freeSummaryUsed, trialUsed).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isNotElevatingRole();
      allow update: if (isOwner(userId) && isNotElevatingRole()) || isAdmin();
      allow delete: if isAdmin();
    }
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Alert Rules: Private notification rules. Strictly forbidden for anonymous users.
    match /alert_rules/{ruleId} {
      allow read: if isAuthenticated() && !isAnonymous() && (
        resource.data.userId == 'system' || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && !isAnonymous() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && !isAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Sent News Alerts: Internal server dispatch tracking
    match /sent_news_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Saved Notes: per-user, login-required, Firestore-first
    match /user_notes/{noteId} {
      allow read: if isAuthenticated() && !isAnonymous() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && !isAnonymous() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && !isAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Payment ledger & entitlements: SERVER ONLY (Admin SDK bypasses rules).
    // Money truth must never be readable or writable from the client.
    match /payment_orders/{orderId} {
      allow read, write: if false;
    }
    match /payment_entitlements/{userId} {
      allow read, write: if false;
    }

    // Admins collection: Strictly restricted to Admin/Server
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Default catch-all: Deny all unauthenticated or unmapped access
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}



